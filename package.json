{
  "name": "outreach-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "check:services": "node --env-file=.env.local scripts/check-services.mjs",
    "test": "vitest run",
    "typecheck": "tsc",
    "check:rubric": "tsx --env-file=.env.local scripts/check-rubric.ts",
    "test:calibration": "tsx --env-file=.env.local scripts/calibration/run.ts",
    "test:access": "node --env-file=.env.local scripts/test-access.mjs",
    "test:lock": "tsx --env-file=.env.local scripts/test-lock.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:e2e": "node --env-file=.env.local scripts/e2e.mjs",
    "screenshots": "node --env-file=.env.local scripts/screenshots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
